<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d0" for="node" attr.name="label" attr.type="string"/>
  <key id="d1" for="node" attr.name="team" attr.type="string"><default>unknown</default></key>
  <key id="d4" for="node" attr.name="tenure" attr.type="int"/>
  <key id="d5" for="node" attr.name="remote" attr.type="boolean"/>
  <key id="d6" for="node" attr.name="score" attr.type="double"/>
  <key id="d2" for="edge" attr.name="weight" attr.type="double"/>
  <key id="d3" for="edge" attr.name="first_contact" attr.type="string"/>
  <key id="d7" for="edge" attr.name="relation" attr.type="string"/>
  <key id="d8" for="edge" attr.name="note" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <!-- a comment with <tags> & stuff -->
    <node id="n0"><data key="d0">Avery Lin</data><data key="d1">Design</data><data key="d4">7</data><data key="d5">True</data><data key="d6">0.25</data></node>
    <node id="n1"><data key="d0">Jos&#233; P&#xE9;rez &amp; Co</data><data key="d4">2</data><data key="d5">false</data></node>
    <node id="n2"><data key="d0">Sam Ortiz</data><data key="d1">Ops</data></node>
    <edge id="e0" source="n0" target="n1"><data key="d2">4</data><data key="d3">2026-03-02T09:15:00Z</data><data key="d7">advice</data></edge>
    <edge id="e1" source="n0" target="n1"><data key="d2">1.5</data><data key="d7">advice</data></edge>
    <edge id="e2" source="n1" target="n2"><data key="d8">hello</data></edge>
    <edge id="e3" source="n2" target="n2"><data key="d2">2</data></edge>
  </graph>
</graphml>
